# Public Supabase project configuration (safe to embed in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional server-only OCR provider key. Never prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=

# No service-role credential is needed by this application.
NODE_ENV=development
